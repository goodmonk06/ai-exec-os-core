// Prisma schema for AI Exec OS Core

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id          String   @id @default(cuid())
  name        String
  description String?
  model       String   // e.g., "gpt-4", "claude-3"
  tools       Json     // Available tools for this agent
  config      Json     // Agent-specific configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  definition  Json     // Workflow definition (steps, agents, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs        Job[]

  @@index([name])
}

model Job {
  id         String    @id @default(cuid())
  workflowId String
  status     JobStatus @default(pending)
  input      Json      // Input parameters for the job
  output     Json?     // Job execution result
  error      Json?     // Error details if failed
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs       JobLog[]

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
}

enum JobStatus {
  pending
  running
  succeeded
  failed
}

model JobLog {
  id        String   @id @default(cuid())
  jobId     String
  level     LogLevel
  message   String
  meta      Json?    // Additional metadata
  createdAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
}

enum LogLevel {
  info
  warn
  error
  debug
}
